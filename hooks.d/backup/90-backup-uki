# Contexto: Timeshift crea snapshots de Btrfs que protegen /, pero no la particion EFI (ESP)
# donde residen los UKIs.
#
# IMPORTANTE (semantica de Timeshift): los backup hooks se ejecutan DESPUES de crear
# el snapshot (run_post_backup_hooks, Main.vala) y Timeshift exporta TS_SNAPSHOT_PATH
# con la ruta del snapshot recien creado. Como un snapshot Btrfs es un punto en el
# tiempo (reflink), copiar los UKIs solo en /etc/timeshift/uki-backup del sistema vivo
# NO los incluiria en el snapshot. Por eso este hook escribe los UKIs en DOS lugares:
#   1. /etc/timeshift/uki-backup          (sistema vivo)
#   2. $TS_SNAPSHOT_PATH/.../uki-backup   (DENTRO del snapshot recien creado)
# Asi cada snapshot queda autocontenido: contiene los UKIs que coinciden con su propio
# kernel/modulos y el restore puede devolverlos a la ESP correctamente.
#

set -euo pipefail

# --- CONFIGURACION ---
# Rutas parametrizables por entorno (TSUKI_*) para poder ejecutar el hook contra
# un arbol de pruebas sin tocar el sistema real (ver tests/smoke.sh y CI).
BACKUP_DIR="${TSUKI_BACKUP_DIR:-/etc/timeshift/uki-backup}"
LOG_FILE="${TSUKI_LOG_FILE:-/var/log/timeshift.log}"
# Elimina del respaldo los UKIs que no corresponden al kernel actualmente en
# ejecucion (uname -r). Con layout kernel-install cada snapshot viaja SOLO con
# el UKI vigente, para que al restaurar se devuelva exactamente el del momento
# de la snapshot. Desactivar conserva todos los UKIs versionados acumulados.
PRUNE_OLD_UKIS=true
# v3.5: elimina de la PARTICION DE ARRANQUE los UKIs versionados cuyo kernel ya
# no esta instalado (no existe /usr/lib/modules/<kver>). kernel-install no poda,
# asi que sin esto /boot/EFI/Linux acumula UKIs de kernels ya desinstalados y,
# con autodeteccion de systemd-boot, cada uno se convierte en una entrada mas
# del menu de arranque. Nunca toca el UKI del kernel en ejecucion (uname -r),
# ni los kernels instalados aunque no esten en ejecucion, ni el preset clasico
# (arch-linux.efi), cuyo nombre no lleva version y por tanto no se puede
# decidir. Desactivar conserva todos los UKIs de la ESP.
PRUNE_ESP_UKIS=true
# Fichero de bloqueo: evita que dos ejecuciones simultaneas (p. ej. un restore a
# mano mientras timeshift-autosnap lanza el backup hook) escriban UKIs a la vez.
LOCK_FILE="${TSUKI_LOCK_FILE:-/run/lock/timeshift-uki-hooks.lock}"
# ----------------------

# --- Carga segura de configuracion de usuario ---
# Valores de fábrica (arriba). Se sobrescriben por /etc/timeshift/uki-hooks.conf
# si existe, y por variables de entorno TSUKI_* si se definen (tests/CI).
# NO se hace 'source' directo: el fichero se lee como root y solo se aceptan
# lineas CLAVE=valor con CLAVE en lista blanca, para evitar inyeccion de codigo
# si alguien con escritura sobre el fichero inserta comandos arbitrarios.
# Además se comprueba que el fichero es propiedad de root y sin escritura para
# grupo/otros (0644 o mas restrictivo).
log() {
    local level="$1"
    shift
    local message="$*"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [UKI Backup Hook] [$level] $message"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [UKI Backup Hook] [$level] $message" >> "$LOG_FILE" 2>/dev/null || true
}

load_conf() {
    local conf_file="$1"
    [ -f "$conf_file" ] || return 0
    local owner_uid perms g o
    owner_uid=$(stat -c %u "$conf_file" 2>/dev/null || true)
    perms=$(stat -c %a "$conf_file" 2>/dev/null || true)
    # Propietario debe ser root (uid 0). Usar uid en vez de nombre por robustez en chroot.
    [ "$owner_uid" = "0" ] || {
        log "WARN" "ukiconf: $conf_file no es de root (uid $owner_uid), se ignora"
        return 0
    }
    # Permisos: rechazar si grupo u otros tienen escritura.
    g="${perms:1:1}"
    o="${perms:2:1}"
    case "$g$o" in
        *[2367]*) {
            log "WARN" "ukiconf: $conf_file tiene escritura para grupo u otros, se ignora"
            return 0
        } ;;
    esac
    local key val line lineno=0
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        # Quitar retorno de carro (CRLF) y espacios finales
        line="${line%$'\r'}"
        line="${line%"${line##*[![:space:]]}"}"
        # Ignorar comentarios y lineas vacias
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line//[[:space:]]/}" ]] && continue
        # Separar en clave y valor por el primer =
        key="${line%%=*}"
        val="${line#*=}"
        # Si no hay '=', la clave es toda la linea (linea sin asignacion)
        [ "$key" = "$line" ] && {
            log "WARN" "ukiconf: linea $lineno sin '=', se ignora: $line"
            continue
        }
        # Quitar espacios alrededor de clave y valor
        key="${key//[[:space:]]/}"
        # Soportar comentario en linea: CLAVE=valor # comentario
        val="${val%%#*}"
        val="${val%"${val##*[![:space:]]}"}"
        # Soportar export PRUNE_UKIS=false
        [[ "$key" =~ ^export[[:space:]]+(.+)$ ]] && key="${BASH_REMATCH[1]}"
        # Soportar comillas alrededor del valor: "false" o 'false'
        [[ "$val" =~ ^\"(.*)\"$ ]] && val="${BASH_REMATCH[1]}"
        [[ "$val" =~ ^\'(.*)\'$ ]] && val="${BASH_REMATCH[1]}"
        case "$key" in
            PRUNE_OLD_UKIS|PRUNE_ESP_UKIS|PRUNE_UKIS)
                if [[ "$val" =~ ^[Tt][Rr][Uu][Ee]$ ]]; then
                    printf -v "$key" "true"
                elif [[ "$val" =~ ^[Ff][Aa][Ll][Ss][Ee]$ ]]; then
                    printf -v "$key" "false"
                else
                    log "WARN" "ukiconf: valor invalido para $key='$val' (linea $lineno), se desactiva"
                    printf -v "$key" "false"
                fi
                ;;
            ESP_MIN_FREE_MB)
                if [[ "$val" =~ ^[0-9]+$ ]]; then
                    printf -v "$key" "$val"
                else
                    log "WARN" "ukiconf: valor invalido para ESP_MIN_FREE_MB='$val' (linea $lineno), se ignora"
                fi
                ;;
            *)
                log "WARN" "ukiconf: clave desconocida '$key' (linea $lineno), se ignora"
                ;;
        esac
    done < "$conf_file"
}
CONF_FILE="${TSUKI_CONF_FILE:-/etc/timeshift/uki-hooks.conf}"
load_conf "$CONF_FILE"
# Las variables de entorno TSUKI_* tienen la última palabra.
PRUNE_OLD_UKIS="${TSUKI_PRUNE_OLD_UKIS:-$PRUNE_OLD_UKIS}"
PRUNE_ESP_UKIS="${TSUKI_PRUNE_ESP_UKIS:-$PRUNE_ESP_UKIS}"

# Kernel en ejecucion. Se resuelve aqui (no dentro de compute_current_ukis)
# porque prune_esp_stale_ukis tambien lo necesita y se ejecuta antes.
# TSUKI_KVER / TSUKI_MODULES_DIR / TSUKI_MACHINE_ID: solo para tests/CI.
CURRENT_KVER="${TSUKI_KVER:-$(uname -r)}"
MODULES_DIR="${TSUKI_MODULES_DIR:-/usr/lib/modules}"

# machine-id de ESTE sistema. Los UKIs de kernel-install se llaman
# <machine-id>-<kver>.efi, y la ESP/XBOOTLDR puede compartirse con otra
# instalacion Linux (otro machine-id). Los hooks solo gestionan los UKIs cuyo
# prefijo coincide con este valor; el resto se trata como ajeno y no se toca.
# Si no se puede determinar, no se poda nada (es preferible no borrar).
MACHINE_ID="${TSUKI_MACHINE_ID:-$({ tr -d '[:space:]' < /etc/machine-id; } 2>/dev/null || true)}"
[[ "$MACHINE_ID" =~ ^[0-9a-f]{32}$ ]] || MACHINE_ID=""

# Temporales de la copia atomica (se borran siempre en el trap de salida).
TMP_FILES=()

# ¿Es $1 (nombre de fichero) un UKI versionado de ESTE sistema? Si lo es,
# deja la version del kernel en UKI_KVER.
own_uki_kver() {
    UKI_KVER=""
    [ -n "$MACHINE_ID" ] || return 1
    [[ "$1" =~ ^${MACHINE_ID}-(.+)\.efi$ ]] || return 1
    UKI_KVER="${BASH_REMATCH[1]}"
    return 0
}

# Verificar si un punto de montaje corresponde a una particion de arranque valida
# (ESP o XBOOTLDR) para evitar confusion con USBs
is_valid_boot_partition() {
    local mount_point="$1"
    local dev
    dev=$(findmnt -no SOURCE "$mount_point" 2>/dev/null | head -1)
    [ -z "$dev" ] && return 1

    local parttype
    parttype=$(lsblk -no PARTTYPE "$dev" 2>/dev/null | head -1)
    [ "$parttype" = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ] || \
    [ "$parttype" = "bc13c2ff-59e6-4262-a352-b275fd6f7172" ]
}

# ¿Es $1 una particion de arranque candidata? Debe estar Montada y tener el
# directorio EFI/Linux. kernel-install crea ese directorio en la particion donde
# instala los UKIs, asi que su presencia es evidencia, no suposicion.
# El requisito de "montada" importa: si /boot no esta montado y un restore
# antiguo dejo un /boot/EFI/Linux en el rootfs, ese directorio no debe pasar
# por una particion de arranque. Mismo criterio que el restore hook (v3.6), para
# que ambos hooks apunten siempre a la misma particion.
is_boot_partition_dir() {
    local d="$1"
    [ -n "$d" ] || return 1
    [ -d "$d" ] && [ ! -L "$d" ] || return 1
    mountpoint -q "$d" 2>/dev/null || return 1
    [ -d "$d/EFI/Linux" ] || return 1
    return 0
}

detect_uki_dir() {
    # Override explicito (arboles de prueba / CI)
    if [ -n "${TSUKI_UKI_DIR:-}" ] && [ -d "$TSUKI_UKI_DIR" ]; then
        echo "$TSUKI_UKI_DIR"
        return 0
    fi

    local dirs=("/boot" "/efi" "/boot/efi")
    local d
    for d in "${dirs[@]}"; do
        if is_boot_partition_dir "$d"; then
            echo "$d/EFI/Linux"
            return 0
        fi
    done
    local esp
    esp=$(findmnt -no TARGET -t vfat 2>/dev/null | while read -r mnt; do
        if [ -d "$mnt/EFI/Linux" ] && is_valid_boot_partition "$mnt"; then
            echo "$mnt"
            break
        fi
    done || true)
    if [ -n "$esp" ]; then
        echo "$esp/EFI/Linux"
        return 0
    fi
    return 1
}

# Calcula el conjunto de UKIs "vigentes" de la ESP (los del kernel actualmente
# en ejecucion, uname -r). Con layout kernel-install conviven multiples UKIs
# versionados (<machine-id>-<kver>.efi); en ese modo cada snapshot debe viajar
# SOLO con el UKI vigente, para que al restaurar se devuelva exactamente el del
# momento de la snapshot. El preset clasico (arch-linux.efi) se conserva en
# maquinas sin kernel-install si sigue existiendo en la ESP.
compute_current_ukis() {
    HAS_VERSIONED=false
    current_uki_files=()
    current_uki_names=()

    for uki in "${uki_files[@]}"; do
        if own_uki_kver "${uki##*/}"; then
            HAS_VERSIONED=true
        fi
    done

    for uki in "${uki_files[@]}"; do
        local base="${uki##*/}"

        if own_uki_kver "$base"; then
            # UKI versionado de este sistema: vigente solo si es del kernel en ejecucion
            [ "$UKI_KVER" = "$CURRENT_KVER" ] || continue
        elif [[ "$base" =~ ^[0-9a-f]{32}-.+\.efi$ ]]; then
            # UKI versionado de OTRA instalacion (otro machine-id): no es nuestro
            continue
        elif [ "$HAS_VERSIONED" = true ]; then
            # Con kernel-install el preset clasico (arch-linux.efi) es legacy
            continue
        fi

        current_uki_files+=("$uki")
        current_uki_names+=("$base")
    done

    # Fallback: si no hay ningun UKI del kernel actual (p.ej. generacion
    # pendiente), no dejar el snapshot sin respaldo ni purgar lo existente
    # (los UKIs versionados de otra instalacion nunca entran en el respaldo)
    if [ ${#current_uki_files[@]} -eq 0 ]; then
        for uki in "${uki_files[@]}"; do
            local base="${uki##*/}"
            if ! own_uki_kver "$base" && [[ "$base" =~ ^[0-9a-f]{32}-.+\.efi$ ]]; then
                continue
            fi
            current_uki_files+=("$uki")
            current_uki_names+=("$base")
        done
    fi
}

# --- v3.5: purga de la particion de arranque (kernel-install) ---

# ¿Esta este kernel instalado? (tiene directorio de modulos). El kernel en
# ejecucion se da siempre por bueno, aunque /usr/lib/modules no sea legible.
kernel_is_installed() {
    local kver="$1"
    [ -n "$kver" ] || return 1
    [ "$kver" = "$CURRENT_KVER" ] && return 0
    [ -d "$MODULES_DIR/$kver" ] && return 0
    return 1
}

# Elimina de $UKI_DIR los UKIs versionados (<machine-id>-<kver>.efi) cuyo kernel
# ya no esta instalado. kernel-install nunca poda, por lo que la ESP acumula
# UKIs de kernels desinstalados; con autodeteccion de systemd-boot cada uno es
# una entrada mas del menu de arranque. Nunca borra el UKI del kernel en
# ejecucion ni de un kernel instalado, ni toca nombres sin version (preset
# clasico arch-linux.efi), que no permiten decidir nada.
prune_esp_stale_ukis() {
    if [ "$PRUNE_ESP_UKIS" != true ]; then
        return 0
    fi

    if [ -z "$MACHINE_ID" ]; then
        log "WARN" "No se pudo determinar el machine-id; no se poda la particion de arranque"
        return 0
    fi

    shopt -s nullglob
    local esp_ukis=("$UKI_DIR"/*.efi)
    shopt -u nullglob
    if [ ${#esp_ukis[@]} -eq 0 ]; then
        return 0
    fi

    # Dos fases: primero se decide QUE se podaria y solo despues se borra. La
    # guarda de supervivientes necesita el calculo completo antes de tocar
    # ningun fichero. Solo se consideran los UKIs de ESTE sistema (machine-id);
    # los de otra instalacion que comparta la particion no se tocan nunca.
    local base kver pruned=0 own=0 survivors=0
    local -A stale=()
    local -a to_prune=()
    for uki in "${esp_ukis[@]}"; do
        base="${uki##*/}"
        own_uki_kver "$base" || continue
        kver="$UKI_KVER"
        own=$((own + 1))
        if kernel_is_installed "$kver"; then
            survivors=$((survivors + 1))
            continue
        fi
        stale["$base"]="$kver"
        to_prune+=("$uki")
    done
    if [ "$own" -eq 0 ] || [ ${#to_prune[@]} -eq 0 ]; then
        return 0
    fi

    # Guarda conservadora: si el borrado dejaria la particion SIN ningun UKI
    # versionado propio, lo mas probable es que el diagnostico sea erroneo
    # (chroot de Live USB: el kernel en ejecucion es el del USB y no coincide
    # con ningun UKI de la ESP; /usr/lib/modules vacio o sin montar). En ese
    # caso no se poda nada: es preferible dejar UKIs obsoletos a quedarse sin
    # arranque.
    if [ "$survivors" -eq 0 ]; then
        log "WARN" "La purga dejaria $UKI_DIR sin ningun UKI versionado propio; no se poda nada (¿kernel en ejecucion ajeno al sistema o $MODULES_DIR sin montar?)"
        return 0
    fi

    for uki in "${to_prune[@]}"; do
        base="${uki##*/}"
        kver="${stale[$base]}"
        if rm -f "$uki"; then
            log "INFO" "Pruned UKI de la particion de arranque (kernel $kver no instalado): $base"
            pruned=$((pruned + 1))
        else
            log "WARN" "No se pudo eliminar el UKI obsoleto de la ESP: $base"
        fi
    done

    if [ "$pruned" -gt 0 ]; then
        log "INFO" "Purgados $pruned UKI(s) obsoletos de $UKI_DIR (kernel ya desinstalado)"
    fi
    return 0
}

# Purga en el destino los UKIs que ya no estan en el conjunto vigente
# La pertenencia se resuelve con un array asociativo en bash puro: con
# `printf ... | grep -qx` la tuberia puede morir por SIGPIPE (grep sale al
# primer match mientras printf sigue escribiendo), y con `set -o pipefail` ese
# 141 se propaga como fallo de la tuberia -> el `!` lo convierte en "no esta en
# el conjunto" y el hook BORRA un UKI que debia conservar. Con listas grandes
# (varios kernels + muchas entradas) la carrera se dispara.
prune_stale_ukis() {
    local dest="$1"

    if [ ${#current_uki_names[@]} -eq 0 ]; then
        log "WARN" "Sin conjunto vigente de UKIs; no se purga nada en $dest"
        return 0
    fi

    local -A keep=()
    local name
    for name in "${current_uki_names[@]}"; do
        keep["$name"]=1
    done

    shopt -s nullglob
    for existing in "$dest"/*.efi; do
        [ -f "$existing" ] || continue
        local base="${existing##*/}"

        # Rotaciones viejas (.bak) se limpian por separado
        [[ "$base" == *".bak."* || "$base" == *".bak.efi" ]] && continue

        if [ -z "${keep[$base]+x}" ]; then
            rm -f "$existing" "${existing%.efi}.efi.sha256"
            log "INFO" "Pruned UKI obsoleto (no corresponde al kernel actual): $base"
        fi
    done
    shopt -u nullglob
}

# Escribe "$1.sha256" con el hash $2 de forma atomica (temporal + mv).
write_sha() {
    local target="$1.sha256" tmp
    tmp=$(mktemp "$1.sha256.tmp_XXXXXX")
    TMP_FILES+=("$tmp")
    printf '%s\n' "$2" > "$tmp"
    mv -f "$tmp" "$target"
}

# Copia los UKIs actuales de la ESP a un directorio destino.
# Selectivo: solo copia los que cambiaron (comparacion SHA256 per-file).
# La purga de obsoletos se aplica SIEMPRE al destino que se recibe: el directorio
# del snapshot es una copia del respaldo de la ejecucion ANTERIOR (el snapshot se
# toma antes que este hook), asi que la purga del respaldo vivo no lo limpia.
# Un UKI identico sin su .sha256 (o con uno distinto) se repara: el restore exige
# el .sha256 y abortaria sin el.
copy_ukis() {
    local dest="$1"
    local count=0 fixed=0

    if [ ! -d "$dest" ]; then
        mkdir -p "$dest"
    fi

    # Temporales huerfanos de una ejecucion anterior interrumpida
    shopt -s nullglob
    for tmp_file in "$dest"/.tmp_* "$dest"/*.sha256.tmp_*; do
        rm -f "$tmp_file"
    done

    # Limpiar archivos .bak huerfanos en destino
    for bak_file in "$dest"/*.bak.*.efi "$dest"/*.bak.efi "$dest"/*.bak.*.efi.sha256 "$dest"/*.bak.efi.sha256; do
        [ -f "$bak_file" ] || continue
        rm -f "$bak_file"
        log "INFO" "Limpiado .bak huerfano en respaldo: ${bak_file##*/}"
    done
    shopt -u nullglob

    # Limpiar archivos .sha256 huerfanos en destino (de UKIs que ya no existen)
    for sha_file in "$dest"/*.sha256; do
        [ -f "$sha_file" ] || continue
        efi_file="${sha_file%.sha256}"
        if [ ! -f "$efi_file" ]; then
            rm -f "$sha_file"
            log "INFO" "Limpiado .sha256 huerfano: ${sha_file##*/}"
        fi
    done

    # Purgar UKIs obsoletos que ya no corresponden al kernel actual
    if [ "$PRUNE_OLD_UKIS" = true ]; then
        prune_stale_ukis "$dest"
    fi

    local uki basename current_sha dest_sha stored_sha temp_file temp_sha
    for uki in "${current_uki_files[@]}"; do
        [ -f "$uki" ] || continue
        basename="${uki##*/}"

        # Omitir archivos .bak (rotaciones viejas)
        if [[ "$basename" == *".bak."* || "$basename" == *".bak.efi" ]]; then
            continue
        fi

        current_sha=$(sha256sum "$uki" | awk '{print $1}')

        if [ -f "$dest/$basename" ]; then
            dest_sha=$(sha256sum "$dest/$basename" | awk '{print $1}')
            if [ "$current_sha" = "$dest_sha" ]; then
                stored_sha=$(awk 'NR==1 {print $1}' "$dest/$basename.sha256" 2>/dev/null || true)
                if [ "$stored_sha" != "$current_sha" ]; then
                    write_sha "$dest/$basename" "$current_sha"
                    log "INFO" "Reparado .sha256 de $basename en $dest"
                    fixed=$((fixed + 1))
                fi
                continue
            fi
        fi

        # Copia atomica: temporal SIN sufijo .efi en el mismo directorio + mv.
        # Una copia a medias nunca queda con el nombre del UKI.
        temp_file=$(mktemp "$dest/.tmp_XXXXXXXX")
        TMP_FILES+=("$temp_file")
        if ! cp --preserve=all "$uki" "$temp_file"; then
            log "ERROR" "Fallo en copia de: $basename -> $dest"
            return 1
        fi
        temp_sha=$(sha256sum "$temp_file" | awk '{print $1}')
        if [ "$temp_sha" != "$current_sha" ]; then
            log "ERROR" "La copia de $basename no coincide con el original (¿UKI modificado durante la copia?)"
            return 1
        fi
        if ! mv -f "$temp_file" "$dest/$basename"; then
            log "ERROR" "Fallo al mover $basename a $dest"
            return 1
        fi
        write_sha "$dest/$basename" "$current_sha"
        log "INFO" "Respaldo exitoso: $basename -> $dest"
        count=$((count + 1))
    done

    if [ "$count" -gt 0 ]; then
        log "INFO" "Finalizado: $count UKIs respaldados en $dest"
    elif [ "$fixed" -eq 0 ]; then
        log "INFO" "Respaldo en $dest actualizado (UKIs identicos). Sin cambios."
    fi
    return 0
}

# --- Exclusion mutua ---
# flock -n (no bloqueante): si otro proceso mantiene el bloqueo, el backup se
# OMITE (WARN + exit 0). Un fallo aqui NO debe romper la transaccion de pacman
# que disparo timeshift-autosnap: el snapshot se crea igual, solo no se
# refresca el respaldo de UKIs. Si el fichero de bloqueo ni siquiera se puede
# abrir (p. ej. /run/lock no escribible), se continua SIN bloqueo: se degrada,
# no se rompe.
if { : >>"$LOCK_FILE"; } 2>/dev/null; then
    exec 9>>"$LOCK_FILE"
    if ! flock -n 9; then
        log "WARN" "Otro proceso mantiene el bloqueo $LOCK_FILE. Se omite el respaldo de UKIs."
        exit 0
    fi
else
    log "WARN" "No se pudo abrir el fichero de bloqueo $LOCK_FILE; se continua sin bloqueo de concurrencia."
fi
# Con la accion por defecto, SIGINT/SIGTERM/SIGHUP no pasan por el flujo normal;
# convertirlas en un exit 130 deja que los traps de salida (si los hubiera) y el
# cierre del fd 9 se ejecuten de forma ordenada.
trap 'exit 130' INT TERM HUP
cleanup_tmp() {
    local f
    if [ ${#TMP_FILES[@]} -gt 0 ]; then
        for f in "${TMP_FILES[@]}"; do
            [ -e "$f" ] && rm -f "$f" 2>/dev/null
        done
    fi
    return 0
}
trap cleanup_tmp EXIT

mkdir -p "$BACKUP_DIR"

UKI_DIR=$(detect_uki_dir) || true
if [ -z "$UKI_DIR" ]; then
    log "WARN" "No se pudo detectar el directorio de UKIs"
    exit 0
fi

log "INFO" "UKI directory detectado: $UKI_DIR"

# Limpiar archivos .bak huerfanos en la ESP (rotaciones viejas que no deberian estar)
shopt -s nullglob
for bak_file in "$UKI_DIR"/*.bak.*.efi "$UKI_DIR"/*.bak.efi; do
    [ -f "$bak_file" ] || continue
    rm -f "$bak_file"
    log "INFO" "Limpiado .bak huerfano en ESP: ${bak_file##*/}"
done
shopt -u nullglob

# v3.5: purgar de la ESP los UKIs de kernels ya desinstalados (kernel-install no
# lo hace). Se hace ANTES de inventariar para que el analisis refleje la ESP real.
prune_esp_stale_ukis

shopt -s nullglob
uki_files=("$UKI_DIR"/*.efi)
shopt -u nullglob

if [ ${#uki_files[@]} -eq 0 ]; then
    log "WARN" "No se encontraron archivos UKI (.efi) en $UKI_DIR"
    exit 0
fi

log "INFO" "Iniciando analisis de UKIs en $UKI_DIR"

# Conjunto de UKIs vigentes (solo los del kernel actual)
compute_current_ukis

# 1. Copia en el sistema vivo (/etc/timeshift/uki-backup)
if ! copy_ukis "$BACKUP_DIR"; then
    exit 1
fi

# 2. Copia DENTRO del snapshot recien creado (TS_SNAPSHOT_PATH)
SNAPSHOT_BACKUP_DIR=""
if [ -n "${TS_SNAPSHOT_PATH:-}" ]; then
    # Layout Btrfs: el snapshot contiene los subvolumenes @ y @home
    if [ -d "$TS_SNAPSHOT_PATH/@/etc" ]; then
        SNAPSHOT_BACKUP_DIR="$TS_SNAPSHOT_PATH/@/etc/timeshift/uki-backup"
    # Layout rsync: Timeshift guarda el arbol del sistema en <snapshot>/localhost/
    elif [ -d "$TS_SNAPSHOT_PATH/localhost/etc" ]; then
        SNAPSHOT_BACKUP_DIR="$TS_SNAPSHOT_PATH/localhost/etc/timeshift/uki-backup"
    else
        log "WARN" "TS_SNAPSHOT_PATH no contiene un sistema reconocible; el snapshot no quedara autocontenido"
    fi
fi

if [ -n "$SNAPSHOT_BACKUP_DIR" ]; then
    log "INFO" "Escribiendo UKIs dentro del snapshot (TS_SNAPSHOT_PATH): $SNAPSHOT_BACKUP_DIR"
    if ! copy_ukis "$SNAPSHOT_BACKUP_DIR"; then
        log "ERROR" "Fallo al escribir los UKIs dentro del snapshot"
        exit 1
    fi
else
    log "INFO" "Sin TS_SNAPSHOT_PATH: solo se actualizo la copia en $BACKUP_DIR"
fi

exit 0
