# Contexto: Timeshift crea snapshots de Btrfs que protegen /, pero no la particion EFI (ESP)
# donde residen los UKIs.
#
# IMPORTANTE (semantica de Timeshift): los backup hooks se ejecutan DESPUES de crear
# el snapshot (run_post_backup_hooks, Main.vala) y Timeshift exporta TS_SNAPSHOT_PATH
# con la ruta del snapshot recien creado. Como un snapshot Btrfs es un punto en el
# tiempo (reflink), copiar los UKIs solo en /etc/timeshift/uki-backup del sistema vivo
# NO los incluiria en el snapshot. Por eso este hook escribe los UKIs en DOS lugares:
#   1. /etc/timeshift/uki-backup          (sistema vivo)
#   2. $TS_SNAPSHOT_PATH/.../uki-backup   (DENTRO del snapshot recien creado)
# Asi cada snapshot queda autocontenido: contiene los UKIs que coinciden con su propio
# kernel/modulos y el restore puede devolverlos a la ESP correctamente.
#

set -euo pipefail

# --- CONFIGURACION ---
BACKUP_DIR="/etc/timeshift/uki-backup"
LOG_FILE="/var/log/timeshift.log"
# Elimina del respaldo los UKIs que no corresponden al kernel actualmente en
# ejecucion (uname -r). Con layout kernel-install cada snapshot viaja SOLO con
# el UKI vigente, para que al restaurar se devuelva exactamente el del momento
# de la snapshot. Desactivar conserva todos los UKIs versionados acumulados.
PRUNE_OLD_UKIS=true
# ----------------------

log() {
    local level="$1"
    shift
    local message="$*"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [UKI Backup Hook] [$level] $message"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [UKI Backup Hook] [$level] $message" >> "$LOG_FILE" 2>/dev/null || true
}

# Verificar si un punto de montaje corresponde a una particion de arranque valida
# (ESP o XBOOTLDR) para evitar confusion con USBs
is_valid_boot_partition() {
    local mount_point="$1"
    local dev
    dev=$(findmnt -no SOURCE "$mount_point" 2>/dev/null | head -1)
    [ -z "$dev" ] && return 1

    local parttype
    parttype=$(lsblk -no PARTTYPE "$dev" 2>/dev/null | head -1)
    [ "$parttype" = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ] || \
    [ "$parttype" = "bc13c2ff-59e6-4262-a352-b275fd6f7172" ]
}

detect_uki_dir() {
    local dirs=("/boot/EFI/Linux" "/efi/EFI/Linux" "/boot/efi/EFI/Linux")
    for d in "${dirs[@]}"; do
        if [ -d "$d" ]; then
            echo "$d"
            return 0
        fi
    done
    local esp
    esp=$(findmnt -no TARGET -t vfat 2>/dev/null | while read -r mnt; do
        if [ -d "$mnt/EFI/Linux" ] && is_valid_boot_partition "$mnt"; then
            echo "$mnt"
            break
        fi
    done)
    if [ -n "$esp" ]; then
        echo "$esp/EFI/Linux"
        return 0
    fi
    return 1
}

# Calcula el conjunto de UKIs "vigentes" de la ESP (los del kernel actualmente
# en ejecucion, uname -r). Con layout kernel-install conviven multiples UKIs
# versionados (<machine-id>-<kver>.efi); en ese modo cada snapshot debe viajar
# SOLO con el UKI vigente, para que al restaurar se devuelva exactamente el del
# momento de la snapshot. El preset clasico (arch-linux.efi) se conserva en
# maquinas sin kernel-install si sigue existiendo en la ESP.
compute_current_ukis() {
    CURRENT_KVER="$(uname -r)"
    HAS_VERSIONED=false
    current_uki_files=()
    current_uki_names=()

    for uki in "${uki_files[@]}"; do
        [[ "${uki##*/}" =~ ^[0-9a-f]{32}-.+\.efi$ ]] && HAS_VERSIONED=true
    done

    for uki in "${uki_files[@]}"; do
        local base="${uki##*/}"

        if [[ "$base" =~ ^[0-9a-f]{32}-.+\.efi$ ]]; then
            # UKI versionado: vigente solo si pertenece al kernel en ejecucion
            [[ "$base" == *"-${CURRENT_KVER}.efi" ]] || continue
        elif [ "$HAS_VERSIONED" = true ]; then
            # Con kernel-install el preset clasico (arch-linux.efi) es legacy
            continue
        fi

        current_uki_files+=("$uki")
        current_uki_names+=("$base")
    done

    # Fallback: si no hay ningun UKI del kernel actual (p.ej. generacion
    # pendiente), no dejar el snapshot sin respaldo ni purgar lo existente
    if [ ${#current_uki_files[@]} -eq 0 ]; then
        current_uki_files=("${uki_files[@]}")
        current_uki_names=()
        for uki in "${current_uki_files[@]}"; do
            current_uki_names+=("${uki##*/}")
        done
    fi
}

# Purga en el destino los UKIs que ya no estan en el conjunto vigente
prune_stale_ukis() {
    local dest="$1"
    shopt -s nullglob
    for existing in "$dest"/*.efi; do
        [ -f "$existing" ] || continue
        local base="${existing##*/}"

        # Rotaciones viejas (.bak) se limpian por separado
        [[ "$base" == *".bak."* || "$base" == *".bak.efi" ]] && continue

        if ! printf '%s\n' "${current_uki_names[@]}" | grep -qx -- "$base"; then
            rm -f "$existing" "${existing%.efi}.efi.sha256"
            log "INFO" "Pruned UKI obsoleto (no corresponde al kernel actual): $base"
        fi
    done
    shopt -u nullglob
}

# Copia los UKIs actuales de la ESP a un directorio destino.
# Selectivo: solo copia los que cambiaron (comparacion SHA256 per-file).
copy_ukis() {
    local dest="$1"
    local count=0

    if [ ! -d "$dest" ]; then
        mkdir -p "$dest"
    fi

    # Limpiar archivos .bak huerfanos en destino
    shopt -s nullglob
    for bak_file in "$dest"/*.bak.*.efi "$dest"/*.bak.efi "$dest"/*.bak.*.efi.sha256 "$dest"/*.bak.efi.sha256; do
        [ -f "$bak_file" ] || continue
        rm -f "$bak_file"
        log "INFO" "Limpiado .bak huerfano en respaldo: ${bak_file##*/}"
    done
    shopt -u nullglob

    # Limpiar archivos .sha256 huerfanos en destino (de UKIs que ya no existen)
    for sha_file in "$dest"/*.sha256; do
        [ -f "$sha_file" ] || continue
        efi_file="${sha_file%.sha256}"
        if [ ! -f "$efi_file" ]; then
            rm -f "$sha_file"
            log "INFO" "Limpiado .sha256 huerfano: ${sha_file##*/}"
        fi
    done

    # Purgar UKIs obsoletos que ya no corresponden al kernel actual
    if [ "$PRUNE_OLD_UKIS" = true ]; then
        prune_stale_ukis "$dest"
    fi

    # Deteccion rapida: si todos los UKIs ya estan identicos, no tocar nada
    local needs_backup=false
    for uki in "${current_uki_files[@]}"; do
        [ -f "$uki" ] || continue
        local basename="${uki##*/}"

        # Omitir archivos .bak (rotaciones viejas)
        if [[ "$basename" == *".bak."* || "$basename" == *".bak.efi" ]]; then
            continue
        fi

        if [ -f "$dest/$basename" ]; then
            local current_sha backup_sha
            current_sha=$(sha256sum "$uki" | awk '{print $1}')
            backup_sha=$(sha256sum "$dest/$basename" | awk '{print $1}')
            if [ "$current_sha" == "$backup_sha" ]; then
                continue
            fi
        fi
        needs_backup=true
        break
    done

    if [ "$needs_backup" = false ]; then
        log "INFO" "Respaldo en $dest actualizado (UKIs identicos). Sin cambios."
        return 0
    fi

    log "INFO" "Iniciando respaldo de UKIs en $dest"

    for uki in "${current_uki_files[@]}"; do
        [ -f "$uki" ] || continue
        local basename="${uki##*/}"

        # Omitir archivos .bak (rotaciones viejas)
        if [[ "$basename" == *".bak."* || "$basename" == *".bak.efi" ]]; then
            continue
        fi

        local current_sha backup_sha
        current_sha=$(sha256sum "$uki" | awk '{print $1}')
        if [ -f "$dest/$basename" ]; then
            backup_sha=$(sha256sum "$dest/$basename" | awk '{print $1}')
            if [ "$current_sha" == "$backup_sha" ]; then
                continue
            fi
        fi

        if cp --preserve=all "$uki" "$dest/$basename"; then
            echo "$current_sha" > "$dest/$basename.sha256"
            log "INFO" "Respaldo exitoso: $basename -> $dest"
            count=$((count + 1))
        else
            log "ERROR" "Fallo en copia de: $basename -> $dest"
            return 1
        fi
    done

    if [ "$count" -gt 0 ]; then
        log "INFO" "Finalizado: $count UKIs respaldados en $dest"
    fi
    return 0
}

mkdir -p "$BACKUP_DIR"

UKI_DIR=$(detect_uki_dir) || true
if [ -z "$UKI_DIR" ]; then
    log "WARN" "No se pudo detectar el directorio de UKIs"
    exit 0
fi

log "INFO" "UKI directory detectado: $UKI_DIR"

shopt -s nullglob
uki_files=("$UKI_DIR"/*.efi)
shopt -u nullglob

if [ ${#uki_files[@]} -eq 0 ]; then
    log "WARN" "No se encontraron archivos UKI (.efi) en $UKI_DIR"
    exit 0
fi

log "INFO" "Iniciando analisis de UKIs en $UKI_DIR"

# Limpiar archivos .bak huerfanos en la ESP (rotaciones viejas que no deberian estar)
shopt -s nullglob
for bak_file in "$UKI_DIR"/*.bak.*.efi "$UKI_DIR"/*.bak.efi; do
    [ -f "$bak_file" ] || continue
    rm -f "$bak_file"
    log "INFO" "Limpiado .bak huerfano en ESP: ${bak_file##*/}"
done
shopt -u nullglob

# Conjunto de UKIs vigentes (solo los del kernel actual)
compute_current_ukis

# 1. Copia en el sistema vivo (/etc/timeshift/uki-backup)
if ! copy_ukis "$BACKUP_DIR"; then
    exit 1
fi

# 2. Copia DENTRO del snapshot recien creado (TS_SNAPSHOT_PATH)
SNAPSHOT_BACKUP_DIR=""
if [ -n "${TS_SNAPSHOT_PATH:-}" ]; then
    # Layout Btrfs: el snapshot contiene los subvolumenes @ y @home
    if [ -d "$TS_SNAPSHOT_PATH/@/etc" ]; then
        SNAPSHOT_BACKUP_DIR="$TS_SNAPSHOT_PATH/@/etc/timeshift/uki-backup"
    # Layout rsync: el snapshot contiene el arbol de archivos directamente
    elif [ -d "$TS_SNAPSHOT_PATH/etc" ]; then
        SNAPSHOT_BACKUP_DIR="$TS_SNAPSHOT_PATH/etc/timeshift/uki-backup"
    else
        log "WARN" "TS_SNAPSHOT_PATH no contiene un sistema reconocible; el snapshot no quedara autocontenido"
    fi
fi

if [ -n "$SNAPSHOT_BACKUP_DIR" ]; then
    log "INFO" "Escribiendo UKIs dentro del snapshot (TS_SNAPSHOT_PATH): $SNAPSHOT_BACKUP_DIR"
    if ! copy_ukis "$SNAPSHOT_BACKUP_DIR"; then
        log "ERROR" "Fallo al escribir los UKIs dentro del snapshot"
        exit 1
    fi
else
    log "INFO" "Sin TS_SNAPSHOT_PATH: solo se actualizo la copia en $BACKUP_DIR"
fi

exit 0
