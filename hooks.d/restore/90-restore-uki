# Contexto: Despues de restaurar un snapshot de Btrfs, este script recupera los UKIs
# que estaban guardados en /etc/timeshift/uki-backup/ (incluidos en el snapshot) y los
# devuelve a la particion EFI (ESP) para que coincidan con el kernel/modulos restaurados.
#
# Seguridad: este hook no aporta ninguna garantia criptografica propia. El .sha256
# que acompana a cada UKI detecta CORRUPCION (copia a medias, bit rot), no
# manipulacion: quien pueda escribir en el respaldo puede reescribir tambien su
# .sha256. Los UKIs van firmados y Secure Boot los valida al arrancar; comprobar
# la firma antes de copiar exigiria llamar a sbctl/sbverify, cosa que este hook no
# hace.
#

set -euo pipefail

# Directorio de respaldo de UKIs. Se resuelve mas abajo (ver nota de TS_SNAPSHOT_PATH),
# porque en el restore Btrfs el respaldo correcto NO es el del sistema vivo.
BACKUP_DIR=""
LOG_FILE="${TSUKI_LOG_FILE:-/var/log/timeshift.log}"
# Margen libre que se quiere dejar en la ESP tras restaurar. El umbral total se
# calcula en tiempo de ejecucion como ESP_MIN_FREE_MB + el tamano de los UKIs que
# de verdad se van a escribir (los identicos se saltan): hasta v3.4 era un valor
# fijo (50 MB) menor que un unico UKI tipico (~75 MB), por lo que el aviso de
# "poco espacio" no podia dispararse cuando realmente no cabia.
ESP_MIN_FREE_MB=20
# Elimina de la particion de arranque los UKIs versionados
# (<machine-id>-<kver>.efi) cuyo kernel no tiene modulos en el root restaurado
# (sync ESP <-> root restaurado). Esencial con layout kernel-install, donde
# conviven multiples UKIs versionados.
PRUNE_UKIS=true
# Fichero de bloqueo: evita que dos ejecuciones simultaneas (p. ej. un restore a
# mano mientras timeshift-autosnap lanza el backup hook) escriban a la vez.
LOCK_FILE="${TSUKI_LOCK_FILE:-/run/lock/timeshift-uki-hooks.lock}"
# ----------------------

# --- Carga segura de configuracion de usuario ---
# Valores de fábrica (arriba). Se sobrescriben por /etc/timeshift/uki-hooks.conf
# si existe, y por variables de entorno TSUKI_* si se definen (tests/CI).
# NO se hace 'source' directo: el fichero se lee como root y solo se aceptan
# lineas CLAVE=valor con CLAVE en lista blanca, para evitar inyeccion de codigo
# si alguien con escritura sobre el fichero inserta comandos arbitrarios.
# Además se comprueba que el fichero es propiedad de root y sin escritura para
# grupo/otros (0644 o mas restrictivo).
log() {
    local level="$1"
    shift
    local message="$*"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [UKI Restore Hook] [$level] $message"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [UKI Restore Hook] [$level] $message" >> "$LOG_FILE" 2>/dev/null || true
}

load_conf() {
    local conf_file="$1"
    [ -f "$conf_file" ] || return 0
    local owner_uid perms g o
    owner_uid=$(stat -c %u "$conf_file" 2>/dev/null || true)
    perms=$(stat -c %a "$conf_file" 2>/dev/null || true)
    # Propietario debe ser root (uid 0). Usar uid en vez de nombre por robustez en chroot.
    [ "$owner_uid" = "0" ] || {
        log "WARN" "ukiconf: $conf_file no es de root (uid $owner_uid), se ignora"
        return 0
    }
    # Permisos: rechazar si grupo u otros tienen escritura.
    g="${perms:1:1}"
    o="${perms:2:1}"
    case "$g$o" in
        *[2367]*) {
            log "WARN" "ukiconf: $conf_file tiene escritura para grupo u otros, se ignora"
            return 0
        } ;;
    esac
    local key val line lineno=0
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        # Quitar retorno de carro (CRLF) y espacios finales
        line="${line%$'\r'}"
        line="${line%"${line##*[![:space:]]}"}"
        # Ignorar comentarios y lineas vacias
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line//[[:space:]]/}" ]] && continue
        # Separar en clave y valor por el primer =
        key="${line%%=*}"
        val="${line#*=}"
        # Si no hay '=', la clave es toda la linea (linea sin asignacion)
        [ "$key" = "$line" ] && {
            log "WARN" "ukiconf: linea $lineno sin '=', se ignora: $line"
            continue
        }
        # Quitar espacios alrededor de clave y valor
        key="${key//[[:space:]]/}"
        # Soportar comentario en linea: CLAVE=valor # comentario
        val="${val%%#*}"
        val="${val%"${val##*[![:space:]]}"}"
        # Soportar export PRUNE_UKIS=false
        [[ "$key" =~ ^export[[:space:]]+(.+)$ ]] && key="${BASH_REMATCH[1]}"
        # Soportar comillas alrededor del valor: "false" o 'false'
        [[ "$val" =~ ^\"(.*)\"$ ]] && val="${BASH_REMATCH[1]}"
        [[ "$val" =~ ^\'(.*)\'$ ]] && val="${BASH_REMATCH[1]}"
        case "$key" in
            PRUNE_OLD_UKIS|PRUNE_ESP_UKIS|PRUNE_UKIS)
                if [[ "$val" =~ ^[Tt][Rr][Uu][Ee]$ ]]; then
                    printf -v "$key" "true"
                elif [[ "$val" =~ ^[Ff][Aa][Ll][Ss][Ee]$ ]]; then
                    printf -v "$key" "false"
                else
                    log "WARN" "ukiconf: valor invalido para $key='$val' (linea $lineno), se desactiva"
                    printf -v "$key" "false"
                fi
                ;;
            ESP_MIN_FREE_MB)
                if [[ "$val" =~ ^[0-9]+$ ]]; then
                    printf -v "$key" "$val"
                else
                    log "WARN" "ukiconf: valor invalido para ESP_MIN_FREE_MB='$val' (linea $lineno), se ignora"
                fi
                ;;
            *)
                log "WARN" "ukiconf: clave desconocida '$key' (linea $lineno), se ignora"
                ;;
        esac
    done < "$conf_file"
}
CONF_FILE="${TSUKI_CONF_FILE:-/etc/timeshift/uki-hooks.conf}"
load_conf "$CONF_FILE"
# Las variables de entorno TSUKI_* tienen la última palabra.
ESP_MIN_FREE_MB="${TSUKI_ESP_MIN_FREE_MB:-$ESP_MIN_FREE_MB}"
PRUNE_UKIS="${TSUKI_PRUNE_UKIS:-$PRUNE_UKIS}"

# --- Resolucion del directorio de respaldo de UKIs ---
# Restore Btrfs in-system: Timeshift NO chrootea; ejecuta este hook en el sistema
# vivo (el root que se descarta al reiniciar) y exporta TS_SNAPSHOT_PATH con la
# ruta del snapshot que se restaura. Si leyeramos /etc/timeshift/uki-backup
# tomaramos los UKIs del estado ACTUAL (el que desaparece), no los del snapshot
# restaurado: tras un cambio de kernel la ESP quedaria con el UKI nuevo y el root
# restaurado (viejo) no arrancaria. Por eso, cuando TS_SNAPSHOT_PATH apunta a un
# sistema, se usa el respaldo que viaja DENTRO del snapshot (autocontenido).
#
# Restore rsync (chroot sobre el arbol restaurado) y ejecucion manual: no hay
# TS_SNAPSHOT_PATH, asi que se usa /etc/timeshift/uki-backup, que en el chroot ya
# es el del snapshot que se restaura.
#
# Si TS_SNAPSHOT_PATH viene definido pero no contiene un sistema reconocible, se
# ABORTA: caer a /etc/timeshift/uki-backup seria restaurar el respaldo del
# sistema vivo, que es exactamente el bug que se corrige aqui. Es preferible no
# tocar la particion de arranque a restaurar UKIs que no corresponden.
ROOT=""
if [ -z "${TSUKI_BACKUP_DIR:-}" ] && [ -n "${TS_SNAPSHOT_PATH:-}" ]; then
    if [ -d "$TS_SNAPSHOT_PATH/@/etc" ]; then
        ROOT="$TS_SNAPSHOT_PATH/@"
    elif [ -d "$TS_SNAPSHOT_PATH/localhost/etc" ]; then
        ROOT="$TS_SNAPSHOT_PATH/localhost"
    else
        log "ERROR" "TS_SNAPSHOT_PATH=\"$TS_SNAPSHOT_PATH\" no contiene un sistema reconocible (ni @/etc ni localhost/etc)."
        log "ERROR" "No se restaura ningun UKI: /etc/timeshift/uki-backup seria el respaldo del sistema VIVO, no el del snapshot."
        log "ERROR" "Comprueba que la ruta del snapshot es correcta o restaura desde el propio snapshot (chroot)."
        exit 1
    fi
fi
if [ -n "$ROOT" ]; then
    BACKUP_DIR="$ROOT/etc/timeshift/uki-backup"
fi
BACKUP_DIR="${TSUKI_BACKUP_DIR:-${BACKUP_DIR:-/etc/timeshift/uki-backup}}"

# Directorio de modulos del root RESTAURADO (el que se va a arrancar), no del
# sistema vivo: con restore in-system el root vivo es justo el que se descarta.
# Un UKI versionado solo puede arrancar si existe <MODULES_DIR>/<kver>.
# Override de tests/CI: TSUKI_MODULES_DIR.
MODULES_DIR="${TSUKI_MODULES_DIR:-${ROOT}/usr/lib/modules}"

# machine-id del root RESTAURADO (el que se va a arrancar). Los UKIs de
# kernel-install se llaman <machine-id>-<kver>.efi y la ESP/XBOOTLDR puede
# compartirse con otra instalacion Linux (otro machine-id): este hook solo poda
# y comprueba los UKIs de ESTE sistema; los ajenos no se tocan nunca. Si no se
# puede determinar, no se poda nada ni se comprueba la coherencia.
# Override de tests/CI: TSUKI_MACHINE_ID.
MACHINE_ID="${TSUKI_MACHINE_ID:-$({ tr -d '[:space:]' < "${ROOT}/etc/machine-id"; } 2>/dev/null || true)}"
[[ "$MACHINE_ID" =~ ^[0-9a-f]{32}$ ]] || MACHINE_ID=""

# ¿Es $1 (nombre de fichero) un UKI versionado de ESTE sistema? Si lo es,
# deja la version del kernel en UKI_KVER.
own_uki_kver() {
    UKI_KVER=""
    [ -n "$MACHINE_ID" ] || return 1
    [[ "$1" =~ ^${MACHINE_ID}-(.+)\.efi$ ]] || return 1
    UKI_KVER="${BASH_REMATCH[1]}"
    return 0
}

# --- Exclusion mutua ---
# flock -n (no bloqueante): si otro proceso mantiene el bloqueo, el restore
# ABORTA. Es preferible no tocar la particion de arranque a hacerlo mientras
# otro proceso escribe UKIs. Si el fichero de bloqueo ni siquiera se puede
# abrir (p. ej. /run/lock no escribible), se continua SIN bloqueo: se degrada,
# no se rompe.
if { : >>"$LOCK_FILE"; } 2>/dev/null; then
    exec 9>>"$LOCK_FILE"
    if ! flock -n 9; then
        log "ERROR" "Otro proceso mantiene el bloqueo $LOCK_FILE. No se restaura ningun UKI."
        exit 1
    fi
else
    log "WARN" "No se pudo abrir el fichero de bloqueo $LOCK_FILE; se continua sin bloqueo de concurrencia."
fi

# Verificar si un punto de montaje corresponde a una particion de arranque valida
# (ESP o XBOOTLDR) para evitar confusion con USBs
is_valid_boot_partition() {
    local mount_point="$1"
    local dev
    dev=$(findmnt -no SOURCE "$mount_point" 2>/dev/null | head -1)
    [ -z "$dev" ] && return 1

    local parttype
    parttype=$(lsblk -no PARTTYPE "$dev" 2>/dev/null | head -1)
    [ "$parttype" = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ] || \
    [ "$parttype" = "bc13c2ff-59e6-4262-a352-b275fd6f7172" ]
}

log "INFO" "Iniciando restauracion de UKIs"

WAS_RO=false
TARGET_MNT=""
# Puntos de montaje que ha montado ESTE script (los del fallback de abajo). Se
# guardan todos para desmontarlos al salir; antes solo habia un booleano y el
# cleanup ni siquiera corria si se abortaba antes de RESTORE_STARTED=true, asi
# que un mount manual podia quedar colgado tras un fallo.
MOUNTED_BY_US=()
# Temporales de la copia atomica. El cleanup los borra SIEMPRE, tambien si el
# script muere entre el cp y el mv (antes quedaban .tmp_* en la ESP).
TMP_FILES=()

# Cleanup seguro al salir (exit, error, o signal). Previene que la ESP quede
# montada RW, que un temporal a medias quede en la particion de arranque o que
# un mount manual quede colgado si el script aborta a mitad.
cleanup() {
    local f mnt
    if [ ${#TMP_FILES[@]} -gt 0 ]; then
        for f in "${TMP_FILES[@]}"; do
            [ -e "$f" ] || continue
            rm -f "$f" 2>/dev/null || true
        done
    fi
    # Remontar a ro solo tiene sentido si este script llego a remontar a rw.
    if [ "$WAS_RO" = true ] && [ -n "$TARGET_MNT" ]; then
        log "INFO" "[cleanup] Restaurando $TARGET_MNT a modo SOLO LECTURA..."
        mount -o remount,ro "$TARGET_MNT" 2>/dev/null || true
    fi
    # Desmontar SIEMPRE lo montado por el script, aunque se aborte antes de
    # empezar a restaurar: si no, un fallo posterior dejaria montajes vivos.
    if [ ${#MOUNTED_BY_US[@]} -gt 0 ]; then
        for mnt in "${MOUNTED_BY_US[@]}"; do
            log "INFO" "[cleanup] Desmontando $mnt (montado por este script)..."
            umount "$mnt" 2>/dev/null || true
        done
    fi
}
trap cleanup EXIT
# Con la accion por defecto, SIGINT/SIGTERM/SIGHUP no ejecutan el trap EXIT (el
# proceso muere sin cleanup). Convertirlas en un exit normal garantiza que se
# ejecute y no queden temporales ni montajes colgados.
trap 'exit 130' INT TERM HUP

# 1. Resolver el punto de montaje de la particion de arranque
#
# Regla (v3.6): una particion es candidata SOLO si tiene el directorio
# EFI/Linux. kernel-install crea ese directorio en la particion donde instala
# los UKIs, asi que su presencia es evidencia, no suposicion. Antes (hasta
# v3.5) se aceptaba el primer mountpoint de /boot, /efi, /boot/efi sin
# comprobar nada, de modo que con dos vfat montadas (dual-boot) y la particion
# correcta sin montar, los UKIs acababan en la particion equivocada; y como el
# destino se creaba con `mkdir -p`, el error ademas se persistia. Ver README,
# seccion "Deteccion de la particion de arranque".
#
# Candidatos, por orden de preferencia:
#   1. /boot, /efi, /boot/efi -> montadas y con el directorio EFI/Linux.
#   2. Cualquier otra vfat montada, que ademas debe tener PARTTYPE de ESP
#      (c12a7328) o XBOOTLDR (bc13c2ff).
# El PARTTYPE solo se exige al buscar fuera de las rutas estandar, que es
# donde cabe confundirse con un USB; en las rutas estandar basta con que la
# particion este montada y tenga EFI/Linux, porque ahi la presencia del
# directorio ya es evidencia de que es la de los UKIs.
# Si no hay ninguna candidata, el hook ABORTA: no inventa un destino.
is_boot_partition_dir() {
    local d="$1"
    [ -n "$d" ] || return 1
    [ -d "$d" ] && [ ! -L "$d" ] || return 1
    mountpoint -q "$d" 2>/dev/null || return 1
    [ -d "$d/EFI/Linux" ] || return 1
    return 0
}

resolve_esp_mount() {
    local dirs=("/boot" "/efi" "/boot/efi")
    local d
    for d in "${dirs[@]}"; do
        if is_boot_partition_dir "$d"; then
            echo "$d"
            return 0
        fi
    done
    local esp
    esp=$(findmnt -no TARGET -t vfat 2>/dev/null | while read -r mnt; do
        if [ -d "$mnt/EFI/Linux" ] && is_valid_boot_partition "$mnt"; then
            echo "$mnt"
            break
        fi
    done || true)
    if [ -n "$esp" ] && [ -d "$esp" ]; then
        echo "$esp"
        return 0
    fi
    return 1
}

# 2. Asegurar el montaje de la particion de arranque
if ! TARGET_MNT=$(resolve_esp_mount); then
    for mnt in /boot /efi /boot/efi; do
        if [ -d "$mnt" ] && [ ! -L "$mnt" ]; then
            if ! mountpoint -q "$mnt" 2>/dev/null; then
                log "INFO" "Intentando montar $mnt..."
                if mount "$mnt" 2>/dev/null; then
                    log "INFO" "$mnt montado exitosamente."
                    MOUNTED_BY_US+=("$mnt")
                fi
            fi
        fi
    done
    # Reintentar la resolucion: lo que vale es lo que resolve_esp_mount()
    # acepte, NO lo que se haya conseguido montar. Antes se aceptaba aqui el
    # primer mountpoint sin validar, que es justo el bug que se corrige.
    TARGET_MNT=$(resolve_esp_mount || true)
fi

if [ -z "$TARGET_MNT" ]; then
    log "ERROR" "No se encontro la particion de arranque con los UKIs (ningun EFI/Linux)."
    log "ERROR" "Se ha buscado en: /boot, /efi, /boot/efi y en cualquier vfat con PARTTYPE de ESP (c12a7328) o XBOOTLDR (bc13c2ff)."
    log "ERROR" "Si los UKIs estan en una particion montada en otro sitio, montala antes de restaurar."
    log "ERROR" "Si la particion esta realmente vacia, crea el directorio a mano: mkdir -p <mnt>/EFI/Linux"
    log "ERROR" "Mas detalle en el README, seccion 'Deteccion de la particion de arranque'."
    exit 1
fi

log "INFO" "Particion de arranque (UKIs) en: $TARGET_MNT"

# Comprobar si esta montado en modo solo lectura (ro)
if findmnt -O ro "$TARGET_MNT" >/dev/null 2>&1; then
    log "INFO" "$TARGET_MNT esta montado como SOLO LECTURA. Remontando en modo LECTURA-ESCRITURA..."
    if ! mount -o remount,rw "$TARGET_MNT" 2>/dev/null; then
        log "ERROR" "No se pudo remontar $TARGET_MNT como RW"
        exit 1
    fi
    WAS_RO=true
fi

# 3. Determinar la ruta de destino para UKIs
# El directorio YA tiene que existir: resolve_esp_mount() solo acepta
# particiones que lo tienen. Antes (hasta v3.5) se creaba con `mkdir -p`, lo
# que hacia que una eleccion erronea de particion quedara "confirmada" para
# siempre en la particion equivocada.
UKI_DIR="$TARGET_MNT/EFI/Linux"
if [ ! -d "$UKI_DIR" ]; then
    log "ERROR" "La particion de arranque $TARGET_MNT no tiene el directorio $UKI_DIR"
    log "ERROR" "No se crea automaticamente para no dejar UKIs en una particion que no los contenia."
    log "ERROR" "Si es el destino correcto, crealo a mano: mkdir -p $UKI_DIR"
    exit 1
fi

# 4. Verificar el directorio de respaldo y la integridad de TODOS los UKIs
if [ ! -d "$BACKUP_DIR" ]; then
    log "ERROR" "No se encontro el directorio de respaldo $BACKUP_DIR"
    exit 1
fi

# Se ignoran las rotaciones .bak antiguas (.bak.<fecha>.efi acaba en .efi y el
# glob lo recogeria). Ya no se generan, pero pueden existir en respaldos viejos.
backup_ukis=()
shopt -s nullglob
for candidate in "$BACKUP_DIR"/*.efi; do
    candidate_base="${candidate##*/}"
    if [[ "$candidate_base" == *".bak."* || "$candidate_base" == *".bak.efi" ]]; then
        log "INFO" "Se ignora la rotacion antigua del respaldo: $candidate_base"
        continue
    fi
    backup_ukis+=("$candidate")
done
shopt -u nullglob

if [ ${#backup_ukis[@]} -eq 0 ]; then
    log "ERROR" "No se encontraron archivos UKI (.efi) de respaldo en $BACKUP_DIR"
    exit 1
fi

# Fase 1: verificar TODOS los checksums ANTES de escribir nada en la ESP. Si el
# segundo UKI estuviera corrupto, el original copiaba el primero y abortaba
# despues, dejando la particion de arranque a medias. Aqui, o estan todos bien
# o no se toca la ESP. El .sha256 es OBLIGATORIO: sin el no hay forma de
# distinguir una copia completa de una truncada.
log "INFO" "Verificando integridad de ${#backup_ukis[@]} UKI(s) respaldados en $BACKUP_DIR..."
declare -A backup_sha=()
to_copy=()
for uki_backup in "${backup_ukis[@]}"; do
    [ -f "$uki_backup" ] || continue
    basename="${uki_backup##*/}"
    sha_file="$uki_backup.sha256"

    if [ ! -f "$sha_file" ]; then
        log "ERROR" "Falta el checksum $sha_file; no se restaura ningun UKI."
        exit 1
    fi

    # Se lee el PRIMER campo, no el fichero entero: el backup hook escribe solo
    # el hash, pero un .sha256 generado con `sha256sum UKI > UKI.sha256` trae
    # "hash  nombre". Comparar el fichero entero contra el hash pelado hacia
    # fallar ese formato aunque el hash fuese correcto.
    expected_sha=$(awk 'NR==1 {print $1}' "$sha_file" 2>/dev/null || true)
    if [ -z "$expected_sha" ]; then
        log "ERROR" "El checksum $sha_file esta vacio o ilegible; no se restaura ningun UKI."
        exit 1
    fi
    actual_sha=$(sha256sum "$uki_backup" | awk '{print $1}')
    if [ "$expected_sha" != "$actual_sha" ]; then
        log "ERROR" "Checksum fallo para $basename. Esperado: $expected_sha, Actual: $actual_sha"
        log "ERROR" "No se restaura ningun UKI (ni siquiera los que estaban bien)."
        exit 1
    fi
    backup_sha["$basename"]="$expected_sha"
    log "INFO" "Checksum verificado para $basename"

    # Saltar si el destino ya tiene exactamente ese UKI.
    if [ -f "$UKI_DIR/$basename" ]; then
        current_sha=$(sha256sum "$UKI_DIR/$basename" | awk '{print $1}')
        if [ "$current_sha" = "$expected_sha" ]; then
            log "INFO" "$basename ya existe e identico en la ESP. Se salta."
            continue
        fi
    fi
    to_copy+=("$uki_backup")
done

# 5. Verificar espacio disponible en la ESP
# Solo cuentan los UKIs que de verdad se van a escribir. Espacio via stat -f
# (bloques libres * tamano de bloque), con df -Pk como respaldo; la expresion
# anterior `esp_avail_mb=$(( ... )) 2>/dev/null || ...` no capturaba el error
# del builtin (la redireccion aplica al builtin, no a la sustitucion).
# -1 = desconocido. 0 es un valor valido (ESP completamente llena).
esp_avail_mb=-1
fs_info=$(stat -f -c '%a %S' "$TARGET_MNT" 2>/dev/null || true)
if [ -n "$fs_info" ]; then
    avail_blocks="${fs_info%% *}"
    block_size="${fs_info##* }"
    if [[ "$avail_blocks" =~ ^[0-9]+$ ]] && [[ "$block_size" =~ ^[0-9]+$ ]] && [ "$block_size" -gt 0 ]; then
        esp_avail_mb=$(( avail_blocks * block_size / 1048576 ))
    fi
fi
if [ "$esp_avail_mb" -lt 0 ]; then
    df_avail_kb=$(df -Pk "$TARGET_MNT" 2>/dev/null | awk 'NR==2 {print $4}' || true)
    if [[ "$df_avail_kb" =~ ^[0-9]+$ ]]; then
        esp_avail_mb=$(( df_avail_kb / 1024 ))
    fi
fi

esp_needed_mb=0
for uki_src in "${to_copy[@]}"; do
    [ -f "$uki_src" ] || continue
    uki_bytes=$(stat -c %s "$uki_src" 2>/dev/null || echo 0)
    [[ "$uki_bytes" =~ ^[0-9]+$ ]] || uki_bytes=0
    esp_needed_mb=$(( esp_needed_mb + (uki_bytes + 1048575) / 1048576 ))
done
required_mb=$(( esp_needed_mb + ESP_MIN_FREE_MB ))

# Pico de ocupacion: el temporal nuevo convive con el UKI viejo hasta el mv
# (rename atomico), asi que hace falta el tamano del nuevo + el margen. El
# viejo ya esta descontado del espacio libre actual.
# Si no hay nada que escribir (todo identico) no se exige margen: abortar aqui
# bloquearia un restore que no necesita espacio.
if [ ${#to_copy[@]} -eq 0 ]; then
    log "INFO" "Nada que escribir en $TARGET_MNT; se omite la comprobacion de espacio."
elif [ "$esp_avail_mb" -lt 0 ]; then
    log "WARN" "No se pudo determinar el espacio libre en $TARGET_MNT; se continua sin comprobacion."
elif [ "$esp_avail_mb" -lt "$required_mb" ]; then
    log "ERROR" "Espacio insuficiente en $TARGET_MNT: ${esp_avail_mb}MB libres, se necesitan ~${required_mb}MB (${esp_needed_mb}MB de UKIs + ${ESP_MIN_FREE_MB}MB de margen)."
    log "ERROR" "No se copia nada: un cp a medias dejaria la particion de arranque sin un UKI completo."
    exit 1
else
    log "INFO" "Espacio en $TARGET_MNT: ${esp_avail_mb}MB libres (necesarios ~${required_mb}MB)"
fi

# 6. Restaurar UKIs (copia atomica + verificacion del temporal)
restored_count=0
if [ ${#to_copy[@]} -gt 0 ]; then
    log "INFO" "Restaurando ${#to_copy[@]} UKI(s) en $UKI_DIR..."
fi
for uki_backup in "${to_copy[@]}"; do
    basename="${uki_backup##*/}"
    expected_sha="${backup_sha[$basename]}"

    # Temporal en el MISMO filesystem que el destino (mv atomico) y SIN sufijo
    # .efi, para que systemd-boot no lo vea como una entrada si el proceso se
    # interrumpe antes del mv.
    temp_file=$(mktemp "$UKI_DIR/.tmp_XXXXXXXX")
    TMP_FILES+=("$temp_file")

    if ! cp --preserve=all "$uki_backup" "$temp_file"; then
        log "ERROR" "No se pudo copiar $basename al temporal $temp_file"
        exit 1
    fi

    # Verificar el TEMPORAL, no el origen: lo que importa es que lo que va a
    # quedar en la ESP se leyo entero y sin corrupcion en el camino.
    temp_sha=$(sha256sum "$temp_file" | awk '{print $1}')
    if [ "$temp_sha" != "$expected_sha" ]; then
        log "ERROR" "El temporal de $basename no coincide con el checksum. Esperado: $expected_sha, Temporal: $temp_sha"
        exit 1
    fi

    # Volcar el temporal a disco antes del rename: si el sistema se cae justo
    # despues del mv, el contenido ya esta en la particion.
    sync -f "$temp_file" 2>/dev/null || sync

    if mv -f "$temp_file" "$UKI_DIR/$basename"; then
        log "INFO" "Restaurado: $basename (checksum verificado)"
        restored_count=$((restored_count + 1))
    else
        log "ERROR" "No se pudo completar la copia atomica de $basename"
        exit 1
    fi
done

# 7. Pruning de UKIs obsoletos en la particion de arranque
# Con layout kernel-install conviven multiples UKIs versionados
# (<machine-id>-<kver>.efi). La pertenencia NO se decide por "esta en el
# respaldo" (el backup hook solo respalda el UKI del kernel en ejecucion, de
# modo que un kernel de respaldo instalado —linux-lts— se podria borrar por
# error), sino por MODULOS: un UKI es arrancable si y solo si existe
# <MODULES_DIR>/<kver> en el root que se acaba de restaurar. Asi se conservan
# los kernels instalados aunque no esten en el respaldo y se eliminan los de
# kernels que ya no existen.
pruned_count=0
if [ "$PRUNE_UKIS" = true ] && [ -z "$MACHINE_ID" ]; then
    log "WARN" "No se pudo determinar el machine-id del root restaurado; no se poda nada."
elif [ "$PRUNE_UKIS" = true ]; then
    log "INFO" "Pruning: podando UKIs de $UKI_DIR sin modulos en $MODULES_DIR..."

    shopt -s nullglob
    esp_ukis=("$UKI_DIR"/*.efi)
    shopt -u nullglob

    # Dos fases: primero se decide QUE se podaria y solo despues se borra. La
    # guarda de supervivientes necesita el calculo completo antes de tocar nada.
    to_prune=()
    survivors=0
    for existing in "${esp_ukis[@]}"; do
        [ -f "$existing" ] || continue
        base="${existing##*/}"

        # Solo se podan los UKIs versionados DE ESTE SISTEMA
        # (<este-machine-id>-<kver>.efi), el layout que gestiona kernel-install.
        # Cualquier otro .efi se conserva: sin version (arch-linux.efi,
        # rescue.efi, etc.) borrarlo podria dejar el sistema sin una entrada de
        # arranque que el snapshot no contiene por diseno; y con otro machine-id
        # pertenece a otra instalacion que comparte la particion.
        if ! own_uki_kver "$base"; then
            log "INFO" "Se conserva UKI que no es de este sistema (sin version o de otro machine-id): $base"
            continue
        fi
        kver="$UKI_KVER"

        if [ -d "$MODULES_DIR/$kver" ]; then
            survivors=$((survivors + 1))
            continue
        fi
        to_prune+=("$existing")
    done

    if [ ${#to_prune[@]} -eq 0 ]; then
        log "INFO" "Pruning completado: sin UKIs obsoletos (${survivors} con modulos en $MODULES_DIR)"
    elif [ "$survivors" -eq 0 ]; then
        # Guarda conservadora: si el borrado dejaria la particion SIN ningun UKI
        # versionado arrancable, lo mas probable es que el diagnostico sea
        # erroneo (chroot sin /usr/lib/modules, MODULES_DIR mal resuelto). Es
        # preferible dejar UKIs obsoletos a quedarse sin arranque.
        log "WARN" "La poda dejaria $UKI_DIR sin ningun UKI versionado con modulos en $MODULES_DIR; no se poda nada."
        log "WARN" "Revisa que $MODULES_DIR corresponda al root que se va a arrancar."
    else
        for existing in "${to_prune[@]}"; do
            base="${existing##*/}"
            if rm -f "$existing"; then
                log "INFO" "Pruned UKI obsoleto (sin modulos en $MODULES_DIR): $base"
                pruned_count=$((pruned_count + 1))
            else
                log "WARN" "No se pudo eliminar el UKI obsoleto: $base"
            fi
        done
        log "INFO" "Pruning completado: $pruned_count eliminado(s), ${survivors} conservado(s)"
    fi
else
    log "INFO" "Pruning desactivado (PRUNE_UKIS=false). Se conservan UKIs no respaldados."
fi

# 8. Comprobacion de coherencia post-restore
# Ultima red: cada UKI versionado que quede en la ESP debe tener sus modulos en
# el root restaurado. Si no, el sistema no arrancaria y es mejor fallar aqui con
# un mensaje claro que reiniciar a ciegas.
if [ -d "$MODULES_DIR" ]; then
    shopt -s nullglob
    coherent=0
    incoherent=0
    for existing in "$UKI_DIR"/*.efi; do
        [ -f "$existing" ] || continue
        base="${existing##*/}"
        own_uki_kver "$base" || continue
        kver="$UKI_KVER"
        if [ -d "$MODULES_DIR/$kver" ]; then
            coherent=$((coherent + 1))
        else
            incoherent=$((incoherent + 1))
            log "ERROR" "Incoherencia: $base no tiene modulos en $MODULES_DIR/$kver"
        fi
    done
    shopt -u nullglob
    if [ "$incoherent" -gt 0 ]; then
        log "ERROR" "El root restaurado no puede arrancar $incoherent UKI(s) de $UKI_DIR. Revisa el snapshot antes de reiniciar."
        exit 1
    fi
    log "INFO" "Coherencia OK: $coherent UKI(s) versionado(s) con modulos en $MODULES_DIR"
else
    log "WARN" "No se pudo verificar la coherencia: $MODULES_DIR no existe. Comprueba a mano que los UKIs de $UKI_DIR corresponden al root restaurado."
fi

# 9. Reportar resultado final
# (la limpieza de ESP/RO y de temporales la maneja el trap EXIT)
if [ "$restored_count" -gt 0 ] || [ "$pruned_count" -gt 0 ]; then
    log "INFO" "EXITO: $restored_count UKIs restaurados, $pruned_count obsoletos eliminados"
else
    log "INFO" "Finalizado: sin cambios (los UKIs de la ESP ya coinciden con el respaldo)"
fi

exit 0
