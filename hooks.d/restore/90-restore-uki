# Contexto: Despues de restaurar un snapshot de Btrfs, este script recupera los UKIs
# que estaban guardados en /etc/timeshift/uki-backup/ (incluidos en el snapshot) y los
# devuelve a la particion EFI (ESP) para que coincidan con el kernel/modulos restaurados.
#
# Seguridad: Los UKIs ya estaban verificados por Secure Boot antes de ser respaldados.
# Este script solo restaura archivos existentes y calcula checksums para verificar integridad.
#

set -euo pipefail

BACKUP_DIR="${TSUKI_BACKUP_DIR:-/etc/timeshift/uki-backup}"
LOG_FILE="${TSUKI_LOG_FILE:-/var/log/timeshift.log}"
# Margen libre que se quiere dejar en la ESP tras restaurar. El umbral total se
# calcula en tiempo de ejecucion como ESP_MIN_FREE_MB + el tamano de los UKIs a
# restaurar: hasta v3.4 era un valor fijo (50 MB) menor que un unico UKI tipico
# (~75 MB), por lo que el aviso de "poco espacio" no podia dispararse cuando
# realmente no cabia.
ESP_MIN_FREE_MB=20
# Elimina de la particion de arranque los UKIs que no estan en el snapshot
# restaurado (sync ESP <-> snapshot). Esencial con layout kernel-install,
# donde conviven multiples UKIs versionados (<machine-id>-<kver>.efi).
PRUNE_UKIS=true
# ----------------------

log() {
    local level="$1"
    shift
    local message="$*"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [UKI Restore Hook] [$level] $message"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [UKI Restore Hook] [$level] $message" >> "$LOG_FILE" 2>/dev/null || true
}

# Verificar si un punto de montaje corresponde a una particion de arranque valida
# (ESP o XBOOTLDR) para evitar confusion con USBs
is_valid_boot_partition() {
    local mount_point="$1"
    local dev
    dev=$(findmnt -no SOURCE "$mount_point" 2>/dev/null | head -1)
    [ -z "$dev" ] && return 1

    local parttype
    parttype=$(lsblk -no PARTTYPE "$dev" 2>/dev/null | head -1)
    [ "$parttype" = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ] || \
    [ "$parttype" = "bc13c2ff-59e6-4262-a352-b275fd6f7172" ]
}

log "INFO" "Iniciando restauracion de UKIs"

WAS_RO=false
TARGET_MNT=""
ESP_MOUNTED_BY_US=false
RESTORE_STARTED=false

# Cleanup seguro al salir (exit, error, o signal). Previene que la ESP quede
# montada RW o que un mount manual quede colgado si el script aborta a mitad.
cleanup() {
    if [ "$RESTORE_STARTED" != "true" ]; then
        return 0
    fi
    if [ "$WAS_RO" = true ] && [ -n "$TARGET_MNT" ]; then
        log "INFO" "[cleanup] Restaurando $TARGET_MNT a modo SOLO LECTURA..."
        mount -o remount,ro "$TARGET_MNT" 2>/dev/null || true
    fi
    if [ "$ESP_MOUNTED_BY_US" = true ] && [ -n "$TARGET_MNT" ]; then
        log "INFO" "[cleanup] Desmontando $TARGET_MNT (montado por este script)..."
        umount "$TARGET_MNT" 2>/dev/null || true
    fi
}
trap cleanup EXIT

# Deteccion de chroot (compatible con systemd, OpenRC, runit, etc.)
detect_chroot() {
    # Metodo 1: systemd-detect-virt (si esta disponible)
    if command -v systemd-detect-virt &>/dev/null; then
        systemd-detect-virt --chroot >/dev/null 2>&1 && return 0
    fi
    # Metodo 2: Comparar namespace de PID
    local my_ns init_ns
    my_ns=$(readlink /proc/self/ns/pid 2>/dev/null || true)
    init_ns=$(readlink /proc/1/ns/pid 2>/dev/null || true)
    [ -n "$my_ns" ] && [ -n "$init_ns" ] && [ "$my_ns" != "$init_ns" ] && return 0
    # Metodo 3: Verificar /.dockerenv
    [ -f /.dockerenv ] && return 0
    # Metodo 4: Verificar /proc/1/cgroup (contenedores)
    if [ -f /proc/1/cgroup ]; then
        grep -qE "docker|lxc|kubepods|containerd" /proc/1/cgroup 2>/dev/null && return 0
    fi
    return 1
}

if detect_chroot; then
    # No hace falta ajustar rutas: /boot, /efi y /boot/efi ya se resuelven
    # dentro del chroot, que es donde el usuario ha montado la ESP.
    log "INFO" "Entorno chroot detectado. Las rutas de la ESP se resuelven dentro del chroot."
fi

# 1. Resolver el punto de montaje de la particion de arranque
# Busca en orden: /boot, /efi, /boot/efi, luego deteccion dinamica por tipo vfat
resolve_esp_mount() {
    local dirs=("/boot" "/efi" "/boot/efi")
    for d in "${dirs[@]}"; do
        if [ -d "$d" ] && [ ! -L "$d" ] && mountpoint -q "$d" 2>/dev/null; then
            echo "$d"
            return 0
        fi
    done
    local esp
    esp=$(findmnt -no TARGET -t vfat 2>/dev/null | while read -r mnt; do
        if [ -d "$mnt/EFI/Linux" ] && is_valid_boot_partition "$mnt"; then
            echo "$mnt"
            break
        fi
    done)
    if [ -n "$esp" ] && [ -d "$esp" ]; then
        echo "$esp"
        return 0
    fi
    return 1
}

# 2. Asegurar el montaje de la particion de arranque
if ! TARGET_MNT=$(resolve_esp_mount); then
    for mnt in /boot /efi /boot/efi; do
        if [ -d "$mnt" ] && [ ! -L "$mnt" ]; then
            if ! mountpoint -q "$mnt" 2>/dev/null; then
                log "INFO" "Intentando montar $mnt..."
                if mount "$mnt" 2>/dev/null; then
                    TARGET_MNT="$mnt"
                    log "INFO" "$mnt montado exitosamente."
                    break
                fi
            fi
        fi
    done
fi

if [ -z "$TARGET_MNT" ]; then
    log "ERROR" "No se pudo detectar ni montar la particion EFI (ESP)"
    exit 1
fi

log "INFO" "ESP montada en: $TARGET_MNT"
RESTORE_STARTED=true

# Comprobar si esta montado en modo solo lectura (ro)
if findmnt -O ro "$TARGET_MNT" >/dev/null 2>&1; then
    log "INFO" "$TARGET_MNT esta montado como SOLO LECTURA. Remontando en modo LECTURA-ESCRITURA..."
    if ! mount -o remount,rw "$TARGET_MNT" 2>/dev/null; then
        log "ERROR" "No se pudo remontar $TARGET_MNT como RW"
        exit 1
    fi
    WAS_RO=true
fi

# 3. Determinar la ruta de destino para UKIs
UKI_DIR="$TARGET_MNT/EFI/Linux"
if [ ! -d "$UKI_DIR" ]; then
    mkdir -p "$UKI_DIR"
    log "INFO" "Directorio $UKI_DIR creado en ESP."
fi

# 4. Verificar si existe el directorio de respaldo
if [ ! -d "$BACKUP_DIR" ]; then
    log "ERROR" "No se encontro el directorio de respaldo $BACKUP_DIR"
    exit 1
fi

shopt -s nullglob
backup_ukis=("$BACKUP_DIR"/*.efi)
shopt -u nullglob

if [ ${#backup_ukis[@]} -eq 0 ]; then
    log "ERROR" "No se encontraron archivos UKI (.efi) de respaldo en $BACKUP_DIR"
    exit 1
fi

# 5. Verificar espacio disponible en ESP
esp_avail_kb=$(df --output=avail "$TARGET_MNT" 2>/dev/null | tail -1)
esp_avail_mb=$((esp_avail_kb / 1024)) 2>/dev/null || esp_avail_mb=0
esp_needed_mb=0
for uki_size in "${backup_ukis[@]}"; do
    [ -f "$uki_size" ] || continue
    uki_bytes=$(stat -c %s "$uki_size" 2>/dev/null || echo 0)
    esp_needed_mb=$((esp_needed_mb + (uki_bytes + 1048575) / 1048576))
done
required_mb=$((esp_needed_mb + ESP_MIN_FREE_MB))
if [ "$esp_avail_mb" -lt "$required_mb" ] && [ "$esp_avail_mb" -gt 0 ]; then
    log "WARN" "Poco espacio disponible en ESP: ${esp_avail_mb}MB (necesarios ~${required_mb}MB: ${esp_needed_mb}MB de UKIs + ${ESP_MIN_FREE_MB}MB de margen)"
    log "WARN" "Continuando de todas formas..."
elif [ "$esp_avail_mb" -gt 0 ]; then
    log "INFO" "Espacio disponible en ESP: ${esp_avail_mb}MB (necesarios ~${required_mb}MB)"
fi

# 6. Limpiar archivos .sha256 huerfanos en respaldo
for sha_file in "$BACKUP_DIR"/*.sha256; do
    [ -f "$sha_file" ] || continue
    efi_file="${sha_file%.sha256}"
    if [ ! -f "$efi_file" ]; then
        rm -f "$sha_file"
        log "INFO" "Limpiado .sha256 huerfano: ${sha_file##*/}"
    fi
done

# Limpiar archivos .bak huerfanos en respaldo (rotaciones viejas)
shopt -s nullglob
for bak_file in "$BACKUP_DIR"/*.bak.*.efi "$BACKUP_DIR"/*.bak.efi "$BACKUP_DIR"/*.bak.*.efi.sha256 "$BACKUP_DIR"/*.bak.efi.sha256; do
    [ -f "$bak_file" ] || continue
    rm -f "$bak_file"
    log "INFO" "Limpiado .bak huerfano en respaldo: ${bak_file##*/}"
done
shopt -u nullglob

# 7. Restaurar UKIs con verificacion de integridad
log "INFO" "Verificando integridad de UKIs respaldados..."

restored_count=0
for uki_backup in "${backup_ukis[@]}"; do
    [ -f "$uki_backup" ] || continue

    basename="${uki_backup##*/}"

    # Omitir archivos .bak (rotaciones viejas)
    if [[ "$basename" == *".bak."* || "$basename" == *".bak.efi" ]]; then
        continue
    fi

    # El backup hook escribe el checksum como "<UKI>.efi.sha256" (p. ej.
    # arch-linux.efi.sha256), asi que el nombre del UKI se conserva intacto.
    sha_file="$uki_backup.sha256"
    expected_sha=""

    if [ -f "$sha_file" ]; then
        expected_sha=$(<"$sha_file")
        actual_sha=$(sha256sum "$uki_backup" | awk '{print $1}')

        if [ "$expected_sha" != "$actual_sha" ]; then
            log "ERROR" "Checksum fallo para $basename. Esperado: $expected_sha, Actual: $actual_sha"
            exit 1
        fi
        log "INFO" "Checksum verificado para $basename"
    else
        log "WARN" "No se encontro archivo SHA256 para $basename, continuando sin verificacion"
    fi

    # Saltar si el archivo ya existe y es identico
    if [ -f "$UKI_DIR/$basename" ]; then
        current_sha=$(sha256sum "$UKI_DIR/$basename" | awk '{print $1}')
        if [ -n "$expected_sha" ] && [ "$current_sha" == "$expected_sha" ]; then
            log "INFO" "El archivo $basename ya existe y es identico en el destino. Saltando."
            continue
        fi
    fi

    # Copiar de forma atomica: escribir en temp, verificar, luego mover
    temp_file="$(mktemp "$UKI_DIR/.tmp_XXXXXXXX")"
    if cp --preserve=all "$uki_backup" "$temp_file"; then
        if mv "$temp_file" "$UKI_DIR/$basename"; then
            log "INFO" "Restaurado: $basename"
            restored_count=$((restored_count + 1))
        else
            log "ERROR" "No se pudo completar la copia atomica de $basename"
            rm -f "$temp_file"
            exit 1
        fi
    else
        log "ERROR" "No se pudo copiar $basename"
        rm -f "$temp_file"
        exit 1
    fi
done

# 7b. Pruning de UKIs obsoletos en la particion de arranque
# Con layout kernel-install conviven multiples UKIs versionados
# (<machine-id>-<kver>.efi). Si queda en la ESP un UKI que no pertenece al
# snapshot restaurado, sus modulos no existiran en el root restaurado y el
# sistema no arrancaria (mismatch kernel/modulos). Por eso sincronizamos la
# particion de arranque con el contenido del snapshot.
pruned_count=0
if [ "$PRUNE_UKIS" = true ]; then
    log "INFO" "Pruning: sincronizando $UKI_DIR con el snapshot restaurado..."

    backup_names=()
    for uki_backup in "${backup_ukis[@]}"; do
        [ -f "$uki_backup" ] || continue
        backup_names+=("${uki_backup##*/}")
    done

    shopt -s nullglob
    for existing in "$UKI_DIR"/*.efi; do
        [ -f "$existing" ] || continue
        base="${existing##*/}"

        # Siempre eliminar rotaciones viejas (.bak)
        if [[ "$base" == *".bak."* || "$base" == *".bak.efi" ]]; then
            rm -f "$existing"
            log "INFO" "Pruned .bak obsoleto: $base"
            pruned_count=$((pruned_count + 1))
            continue
        fi

        # Eliminar UKIs que no estan en el snapshot respaldado
        if ! printf '%s\n' "${backup_names[@]}" | grep -qx -- "$base"; then
            rm -f "$existing"
            log "INFO" "Pruned UKI obsoleto (no existe en el snapshot): $base"
            pruned_count=$((pruned_count + 1))
        fi
    done
    shopt -u nullglob

    if [ "$pruned_count" -gt 0 ]; then
        log "INFO" "Pruning completado: $pruned_count archivos eliminados"
    else
        log "INFO" "Pruning completado: sin archivos obsoletos"
    fi
else
    log "INFO" "Pruning desactivado (PRUNE_UKIS=false). Se conservan UKIs no respaldados."
fi

# 8. Reportar resultado final
# (la limpieza de ESP/RO la maneja el trap EXIT)
if [ "$restored_count" -gt 0 ] || [ "$pruned_count" -gt 0 ]; then
    log "INFO" "EXITO: $restored_count UKIs restaurados, $pruned_count obsoletos eliminados"
else
    log "INFO" "Finalizado: Sin archivos restaurados (el respaldo podria no contener UKIs .efi)"
fi

exit 0
